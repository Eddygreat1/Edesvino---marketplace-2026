<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#111827">
  <title>Product Details | Edesvino Marketplace">

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f3f4f6;
      color: #1f2937;
    }

    header {
      background: #111827;
      color: white;
      text-align: center;
      padding: 22px 16px;
    }

    header h1 {
      margin: 0 0 7px;
    }

    .container {
      max-width: 900px;
      margin: auto;
      padding: 20px 14px 35px;
    }

    .panel {
      background: white;
      border-radius: 12px;
      padding: 18px;
      box-shadow: 0 2px 8px #00000010;
    }

    .back {
      display: inline-block;
      margin-bottom: 15px;
      color: #047857;
      font-weight: bold;
      text-decoration: none;
    }

    .product {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 22px;
      align-items: start;
    }

    .product-image {
      width: 100%;
      min-height: 220px;
      max-height: 420px;
      object-fit: contain;
      background: #fff;
      border-radius: 8px;
    }

    h2 {
      margin-top: 0;
      overflow-wrap: anywhere;
    }

    .price {
      color: #047857;
      font-size: 26px;
      font-weight: bold;
      margin: 12px 0;
    }

    .muted {
      color: #6b7280;
      font-size: 14px;
    }

    .description {
      line-height: 1.7;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }

    label {
      display: block;
      font-weight: bold;
      margin: 18px 0 7px;
    }

    input {
      width: 100%;
      max-width: 120px;
      padding: 11px;
      border: 1px solid #d1d5db;
      border-radius: 7px;
      font-size: 16px;
    }

    button,
    .button {
      display: block;
      width: 100%;
      border: 0;
      border-radius: 7px;
      padding: 13px 14px;
      margin-top: 12px;
      background: #111827;
      color: white;
      font-size: 15px;
      font-weight: bold;
      text-align: center;
      text-decoration: none;
      cursor: pointer;
    }

    .secondary {
      background: #047857;
    }

    .message {
      min-height: 22px;
      margin-top: 14px;
      line-height: 1.5;
    }

    .error {
      color: #b91c1c;
    }

    .success {
      color: #047857;
    }

    @media (max-width: 650px) {
      .product {
        grid-template-columns: 1fr;
      }

      .product-image {
        max-height: 320px;
      }
    }
  </style>
</head>

<body>

  <header>
    <h1>Edesvino Marketplace</h1>
    <p>Product Details</p>
  </header>

  <main class="container">

    <a class="back" href="./index.html">
      ← Back to Marketplace
    </a>

    <section class="panel" id="status" aria-live="polite">
      Loading product details...
    </section>

    <p id="message"
       class="message"
       role="status"
       aria-live="polite"></p>

  </main>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <script>
    const SUPABASE_URL =
      "https://lxszilqypuglxyfyukdg.supabase.co";

    const SUPABASE_PUBLISHABLE_KEY =
      "sb_publishable_s0nfQzd5aJVQjHSNAxsJsg_2ZVe5UQh";

    const CART_KEY = "edesvinoMarketplaceCart";

    const statusBox = document.getElementById("status");
    const messageBox = document.getElementById("message");

    function safeText(value) {
      return String(value ?? "").replace(/[&<>"']/g, char => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
      })[char]);
    }

    function validImageUrl(value) {
      try {
        const url = new URL(value);

        return ["https:", "http:"].includes(url.protocol)
          ? url.href
          : "";
      } catch {
        return "";
      }
    }

    function money(value) {
      const amount = Number(value);

      return Number.isFinite(amount)
        ? "₦" + amount.toLocaleString("en-NG")
        : "Price unavailable";
    }

    function readCart() {
      try {
        const cart = JSON.parse(
          localStorage.getItem(CART_KEY) || "[]"
        );

        if (!Array.isArray(cart)) return [];

        return cart.filter(item =>
          item &&
          item.id !== undefined &&
          typeof item.name === "string" &&
          Number.isFinite(Number(item.price)) &&
          Number(item.price) >= 0 &&
          Number.isInteger(Number(item.quantity)) &&
          Number(item.quantity) > 0
        ).map(item => ({
          id: String(item.id),
          name: item.name,
          price: Number(item.price),
          quantity: Number(item.quantity)
        }));

      } catch {
        return [];
      }
    }

    function addToCart(product, quantity) {
      const id = String(product.id ?? "");
      const name = String(product.name ?? "").trim();
      const price = Number(product.price);

      if (!id || !name ||
          !Number.isFinite(price) || price < 0) {

        messageBox.className = "message error";

        messageBox.textContent =
          "This product has incomplete information and could not be added.";

        return;
      }

      const cart = readCart();

      const existing = cart.find(item => item.id === id);

      if (existing) {
        existing.quantity += quantity;
      } else {
        cart.push({
          id: id,
          name: name,
          price: price,
          quantity: quantity
        });
      }

      try {
        localStorage.setItem(
          CART_KEY,
          JSON.stringify(cart)
        );

        messageBox.className = "message success";

        messageBox.textContent =
          name + " (quantity " + quantity +
          ") added to your cart.";

      } catch {
        messageBox.className = "message error";

        messageBox.textContent =
          "Could not save your cart on this device. Check your browser settings.";
      }
    }

    function showProduct(product) {
      const imageUrl = validImageUrl(product.image_url);

      const storeName =
        product.store_name || product.store || "";

      statusBox.innerHTML = `
        <article class="product">

          <div>
            ${
              imageUrl
                ? `<img
                     class="product-image"
                     src="${safeText(imageUrl)}"
                     alt="${safeText(product.name)}">`
                : `<div
                     class="product-image"
                     role="img"
                     aria-label="No product image available">
                   </div>`
            }
          </div>

          <div>

            <h2>
              ${safeText(product.name || "Unnamed product")}
            </h2>

            <p class="price">
              ${money(product.price)}
            </p>

            ${
              storeName
                ? `<p class="muted">
                     Store: ${safeText(storeName)}
                   </p>`
                : ""
            }

            <h3>Product description</h3>

            <p class="description">
              ${safeText(
                product.description ||
                "No description has been provided for this product yet."
              )}
            </p>

            <label for="quantity">Quantity</label>

            <input
              id="quantity"
              type="number"
              min="1"
              max="99"
              step="1"
              value="1"
              inputmode="numeric">

            <button
              type="button"
              id="addButton"
              class="secondary">
              Add to Cart
            </button>

            <a class="button" href="./cart.html">
              View Shopping Cart
            </a>

            <a class="button" href="./index.html">
              Continue Shopping
            </a>

          </div>

        </article>
      `;

      document
        .getElementById("addButton")
        .addEventListener("click", () => {

          const quantityInput =
            document.getElementById("quantity");

          const quantity = Number(quantityInput.value);

          if (
            !Number.isInteger(quantity) ||
            quantity < 1 ||
            quantity > 99
          ) {
            messageBox.className = "message error";

            messageBox.textContent =
              "Please enter a quantity from 1 to 99.";

            return;
          }

          addToCart(product, quantity);
        });
    }

    async function loadProduct() {
      const id =
        new URLSearchParams(window.location.search).get("id");

      if (!id || !/^[a-zA-Z0-9_-]+$/.test(id)) {

        statusBox.innerHTML = `
          <h2>Product not selected</h2>

          <p>
            Open the marketplace and choose a product
            to view its details.
          </p>

          <a class="button" href="./index.html">
            Browse Marketplace
          </a>
        `;

        return;
      }

      if (!window.supabase) {
        statusBox.textContent =
          "The connection library could not load. Check your internet connection and try again.";

        return;
      }

      try {
        const client = window.supabase.createClient(
          SUPABASE_URL,
          SUPABASE_PUBLISHABLE_KEY
        );

        const { data, error } = await client
          .from("products")
          .select("*")
          .eq("id", id)
          .maybeSingle();

        if (error) throw error;

        if (!data) {
          statusBox.innerHTML = `
            <h2>Product not found</h2>

            <p>
              This product may no longer be available.
            </p>

            <a class="button" href="./index.html">
              Browse Marketplace
            </a>
          `;

          return;
        }

        showProduct(data);

      } catch (error) {
        console.error(
          "Product details loading error:",
          error
        );

        statusBox.textContent =
          "Product details could not be loaded. Please return to the marketplace and try again.";
      }
    }

    loadProduct();
  </script>

</body>
</html>
